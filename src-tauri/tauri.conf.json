{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squirrel Fight Online",
  "mainBinaryName": "squirrel_fight_online",
  "version": "1.0.94",
  "identifier": "com.ssdz.online",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "松鼠大战 Online",
        "url": "index.html",
        "width": 1216,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "additionalBrowserArgs": "--no-proxy-server --proxy-bypass-list=*"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "松鼠大战 Online",
    "longDescription": "经典界面的服务器权威联机客户端，本地资源与远端账号服务独立。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
